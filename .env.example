# ==========================================
# DISCORD BOT CONFIGURATION
# ==========================================
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_guild_id_here

# ==========================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==========================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hackathon_db

# ==========================================
# HACKATHON TEAM RULES
# ==========================================
MIN_TEAM_SIZE=2
MAX_TEAM_SIZE=4
INVITATION_EXPIRE_HOURS=24

# NOTE: All Discord Role IDs, Channel IDs, and Category IDs are now configured
# dynamically directly in Discord using the /setup-config command!
