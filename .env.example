# ==========================================
# DISCORD BOT CONFIGURATION
# ==========================================
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_guild_id_here

# ==========================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==========================================
# Example: postgresql://postgres:password@localhost:5432/hackathon_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hackathon_db

# ==========================================
# HACKATHON TEAM RULES
# ==========================================
MIN_TEAM_SIZE=2
MAX_TEAM_SIZE=4
INVITATION_EXPIRE_HOURS=24

# ==========================================
# DISCORD CATEGORIES (Channel IDs)
# ==========================================
REGISTRATION_CATEGORY_ID=
TEAM_PARENT_CATEGORY_ID=
SUPPORT_CATEGORY_ID=

# ==========================================
# DISCORD ROLES (Role IDs)
# ==========================================
ADMINISTRATOR_ROLE_ID=
STAFF_ROLE_ID=
TECHNICAL_SUPPORT_ROLE_ID=
JUDGE_ROLE_ID=
PARTICIPANT_ROLE_ID=
UNREGISTERED_ROLE_ID=

# ==========================================
# DISCORD CHANNELS (Channel IDs)
# ==========================================
LOG_CHANNEL_ID=
REGISTRATION_CHANNEL_ID=
SUPPORT_CHANNEL_ID=
